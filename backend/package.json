{
  "name": "stremio-letterboxd-backend",
  "version": "1.2.2",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const{cpSync,existsSync}=require('fs');if(existsSync('src/db/migrations'))cpSync('src/db/migrations','dist/db/migrations',{recursive:true});\"",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@esp4ce/letterboxd-client": "^1.6.1",
    "@fastify/compress": "^9.2.1",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "lru-cache": "^11.5.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "posthog-node": "^5.55.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "msw": "^2.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
